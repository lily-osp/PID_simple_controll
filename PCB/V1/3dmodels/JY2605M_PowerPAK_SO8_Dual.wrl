#VRML V2.0 utf8
# Dimensionally correct stand-in for the JY2605M dual N-channel MOSFET in
# PowerPAK SO-8 Dual (body 6.15 x 5.15 x 1.05 mm, 1.27 mm lead pitch, two
# exposed drain pads on the underside). Built from the same geometry as the
# land pattern in PCB/V1/footprints/JY2605M_PowerPAK_SO8_Dual.kicad_mod, which
# comes from KiCad's Package_SO:PowerPAK_SO-8_Dual.
# No vendor STEP exists for this part (Shanghai Juyi publishes a drawing only).
# Units are 0.1 inch (KiCad VRML), i.e. millimetres / 2.54.

# --- moulded body ---
Transform {
  translation 0 0 0.2165
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.13 0.13 0.14 } }
    geometry Box { size 2.4213 2.0276 0.3740 } } ]
}

# --- pin-1 chamfer marker (top-left corner of the body) ---
Transform {
  translation -1.0630 0.8858 0.4055
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.45 0.45 0.47 } }
    geometry Box { size 0.2362 0.2362 0.0394 } } ]
}

# --- gull-wing leads, left row: 1 = S1, 2 = G1, 3 = S2, 4 = G2 ---
Transform { translation -1.0512  0.7500 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.80 0.81 0.83 } }
    geometry Box { size 0.5000 0.2402 0.0394 } } ] }
Transform { translation -1.0512  0.2500 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.80 0.81 0.83 } }
    geometry Box { size 0.5000 0.2402 0.0394 } } ] }
Transform { translation -1.0512 -0.2500 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.80 0.81 0.83 } }
    geometry Box { size 0.5000 0.2402 0.0394 } } ] }
Transform { translation -1.0512 -0.7500 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.80 0.81 0.83 } }
    geometry Box { size 0.5000 0.2402 0.0394 } } ] }

# --- drain leads, right row: 5, 6 = D2 and 7, 8 = D1 ---
Transform { translation 1.1004  0.7500 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.80 0.81 0.83 } }
    geometry Box { size 0.4016 0.2402 0.0394 } } ] }
Transform { translation 1.1004  0.2500 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.80 0.81 0.83 } }
    geometry Box { size 0.4016 0.2402 0.0394 } } ] }
Transform { translation 1.1004 -0.2500 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.80 0.81 0.83 } }
    geometry Box { size 0.4016 0.2402 0.0394 } } ] }
Transform { translation 1.1004 -0.7500 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.80 0.81 0.83 } }
    geometry Box { size 0.4016 0.2402 0.0394 } } ] }

# --- exposed drain pads underneath: D1 (pin 7) and D2 (pin 6) ---
Transform { translation 0.2717 -0.4449 0.0197
  children [ Shape { appearance Appearance { material Material { diffuseColor 0.72 0.73 0.75 } }
    geometry Box { size 1.5000 0.6496 0.0394 } } ] }
